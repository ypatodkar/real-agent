.DS_Store
__pycache__/

# Local config and secrets.
# Skills are project config and should survive a clone, so they are re-included.
# Note: gitignore has no inline comments, and re-including a directory also
# requires re-including its contents.
.claude/*
!.claude/skills/
!.claude/skills/**
.env
.mcp.json

# Generated, and reproducible from tools/ — regenerate rather than clone.
assets/fixtures/
out/
runs/

# Credentials must never sit in the working tree, not even untracked: one
# `git add -A` publishes them. There are no tracked .json files in this repo,
# so a blanket rule is the safe default rather than an inconvenience.
*.json
credentials*
service-account*
*.pem
*.p12
store/

# Local databases hold the filmmaker's own story material: never commit them.
# The path moved when the interview build came up to the project root, so this
# is written as a shape rather than a location.
data/
*.db
*.sqlite3
*-wal
*-shm
*.lock
